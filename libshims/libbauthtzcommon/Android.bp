// libbauthserver.so (stock fingerprint) gets this as an extra NEEDED entry
cc_library_shared {
    name: "libbauthtzcommon_shim",
    srcs: ["libbauthtzcommon.c"],
    shared_libs: ["liblog"],
    vendor: true,
    compile_multilib: "32",
}
