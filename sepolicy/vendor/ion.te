# Legacy ION (/dev/ion): Android 17's platform policy still defines
# ion_device but no longer labels the node or grants it to anyone. The Exynos
# camera, gralloc, HWC and codecs on this 3.18 kernel still allocate from it.
allow { hal_camera_default hal_graphics_allocator_default hal_graphics_composer_default mediacodec cameraserver } ion_device:chr_file rw_file_perms;
allow { surfaceflinger bootanim } ion_device:chr_file rw_file_perms;
