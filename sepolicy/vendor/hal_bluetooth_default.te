# /dev/ttySAC3
allow hal_bluetooth_default bluetooth_device:chr_file rw_file_perms;

# /efs
allow hal_bluetooth_default efs_file:dir r_dir_perms;
r_dir_file(hal_bluetooth_default, bluetooth_efs_file)

# sysfs
allow hal_bluetooth_default sysfs:file rw_file_perms;

set_prop(hal_bluetooth_default, vendor_bluetooth_prop)

# QCA9377 power (rfkill) and the wcnss_filter HCI bridge
allow hal_bluetooth_default rfkill_device:chr_file rw_file_perms;
unix_socket_connect(hal_bluetooth_default, property, wcnss_filter)
