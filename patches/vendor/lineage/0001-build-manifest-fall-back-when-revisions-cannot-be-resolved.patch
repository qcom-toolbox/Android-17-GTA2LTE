From: qcom-toolbox <169756160+qcom-toolbox@users.noreply.github.com>
Subject: [PATCH] build-manifest: fall back when revisions cannot be resolved

repo manifest -r fails when a project in the manifest is not checked
out. Fall back to the unpinned manifest instead of failing the build.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
diff --git a/build/tasks/build-manifest_xml.mk b/build/tasks/build-manifest_xml.mk
index 5f54967..6de1567 100644
--- a/build/tasks/build-manifest_xml.mk
+++ b/build/tasks/build-manifest_xml.mk
@@ -18,7 +18,7 @@ endif
 
 $(INSTALLED_BUILD_MANIFEST_XML_TARGET):
 	mkdir -p $(dir $@)
-	REPO_TRACE=0 python3 .repo/repo/repo manifest -o - -r | grep -Ev "proprietary_$(MANIFEST_EXCLUDES)" > $@
+	(REPO_TRACE=0 python3 .repo/repo/repo manifest -o - -r 2>/dev/null || REPO_TRACE=0 python3 .repo/repo/repo manifest -o -) | grep -Ev "proprietary_$(MANIFEST_EXCLUDES)" > $@
 
 .PHONY: build-manifest.xml
 build-manifest.xml: $(INSTALLED_BUILD_MANIFEST_XML_TARGET)
